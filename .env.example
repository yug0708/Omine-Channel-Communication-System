# ==============================================================================
# OMINE-CHANNEL COMMUNICATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# For separate Dev and Main databases with identical structure:
#
# DEV ENVIRONMENT:
# DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[DEV_HOST]/neondb?sslmode=require"
#
# MAIN / PRODUCTION ENVIRONMENT:
# DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[MAIN_HOST]/neondb?sslmode=require"
#
# To apply the identical database structure to any database, run:
#   npm run db:migrate
#
DATABASE_URL="postgresql://neondb_owner:npg_WcAawd24Vthv@ep-proud-sea-avgxanxj-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. SERVER & AUTHENTICATION
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET="your_production_jwt_secret_key_here"

# Frontend API URL
# Leave empty for relative calls (Vercel production and local Vite proxy)
# Set to "http://localhost:5000" if running frontend on a separate standalone origin
VITE_API_URL=""

# ------------------------------------------------------------------------------
# 3. WHATSAPP / META CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_REDIRECT_URI="https://omine-channel-communication-system-opal.vercel.app/api/whatsapp/callback"
